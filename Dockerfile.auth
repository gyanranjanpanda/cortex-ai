FROM node:20-alpine

WORKDIR /app

# Install backend root deps (shared ioredis/dotenv)
COPY backend/package*.json ./
RUN npm ci --omit=dev

# Install auth service deps
COPY backend/services/auth/package*.json ./services/auth/
RUN cd services/auth && npm ci --omit=dev

# Copy source
COPY backend/services/auth ./services/auth
COPY backend/shared ./shared

WORKDIR /app/services/auth

EXPOSE 8001

CMD ["npm", "start"]
