FROM node:20-alpine

WORKDIR /app

# Install backend root deps (shared ioredis/dotenv)
COPY backend/package*.json ./
RUN npm ci --omit=dev

# Install chat service deps
COPY backend/services/chat/package*.json ./services/chat/
RUN cd services/chat && npm ci --omit=dev

# Copy source
COPY backend/services/chat ./services/chat
COPY backend/shared ./shared

WORKDIR /app/services/chat

EXPOSE 8002

CMD ["npm", "start"]
