FROM node:20-alpine AS builder

WORKDIR /app

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ ./

# Bake production environment variables at build time
ENV VITE_SERVER_URL=https://cortex-ai-production-b653.up.railway.app
ENV VITE_FIREBASE_API_KEY=AIzaSyD5CDYsJnDgY48ZPbTaqI5wFjoZXhIz8WA

RUN npm run build

# Production: serve with nginx (Railway-compatible, handles $PORT correctly)
FROM nginx:alpine

# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# Write a template nginx config that uses $PORT
RUN printf 'server {\n  listen ${PORT};\n  root /usr/share/nginx/html;\n  index index.html;\n  location / {\n    try_files $uri $uri/ /index.html;\n  }\n}\n' > /etc/nginx/templates/default.conf.template

COPY --from=builder /app/dist /usr/share/nginx/html

# nginx docker image auto-runs envsubst on /etc/nginx/templates/*.template
# and writes the result to /etc/nginx/conf.d/ before starting nginx
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
