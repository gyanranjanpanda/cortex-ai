FROM node:20-alpine AS builder

WORKDIR /app

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ ./

# Bake production environment variables at build time
ENV VITE_SERVER_URL=https://cortex-ai-production-b653.up.railway.app
ENV VITE_FIREBASE_API_KEY=AIzaSyD5CDYsJnDgY48ZPbTaqI5wFjoZXhIz8WA

RUN npm run build

# Production: serve with a lightweight static server
FROM node:20-alpine

WORKDIR /app
RUN npm install -g serve

COPY --from=builder /app/dist ./dist

# Railway injects $PORT at runtime — use sh -c to ensure expansion
CMD ["/bin/sh", "-c", "serve -s dist -l ${PORT:-3000}"]
