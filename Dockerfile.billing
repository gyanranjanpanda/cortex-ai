FROM node:20-alpine

WORKDIR /app

# Install backend root deps (shared ioredis/dotenv)
COPY backend/package*.json ./
RUN npm ci --omit=dev

# Install billing service deps
COPY backend/services/billing/package*.json ./services/billing/
RUN cd services/billing && npm ci --omit=dev

# Copy source
COPY backend/services/billing ./services/billing
COPY backend/shared ./shared

WORKDIR /app/services/billing

EXPOSE 8004

CMD ["npm", "start"]
